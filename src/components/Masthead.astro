---
import { config, sitePath } from '../lib/site';
const navLinks = [
  { href: '/', label: 'Journal' },
  { href: '/tags/', label: 'Topics' },
  { href: '/desk/', label: 'Desks' },
  { href: '/series/', label: 'Series' },
  { href: '/archive/', label: 'Archive' },
  { href: '/about/', label: 'About' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const path = sitePath(href).replace(/\/+$/, '') || '/';
  return currentPath === path || (href !== '/' && currentPath.startsWith(`${path}/`));
};
---

<header class="masthead">
  <div class="container masthead__inner">
    <a class="masthead__brand" href={sitePath('/')} aria-label={config.title}>
      <svg class="brand-mark" viewBox="0 0 36 36" aria-hidden="true">
        <rect width="36" height="36" rx="10" fill="currentColor" />
        <path d="M10 25 18 10l8 15M13 20h10" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="masthead__nameplate">{config.title}<span class="masthead__tagline">An independent cloud journal</span></span>
    </a>
    <nav class="masthead__nav" aria-label="Sections">
      {navLinks.map((link) => (
        <a href={sitePath(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <a class="masthead__search" href={sitePath('/search/')} aria-label="Search the journal" aria-current={isActive('/search/') ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
      <span>Search</span>
    </a>
  </div>
</header>
