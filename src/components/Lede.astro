---
import type { BlogItem } from '../lib/content';
import { formatDate, sitePath } from '../lib/site';

type Props = { post: BlogItem };
const { post } = Astro.props;
const href = sitePath(`/${post.slug}/`);
const author = post.authors[0];
const deskName = post.desk?.desk.name ?? 'From the desk';
const sectionId = post.desk?.sectionId ?? '';
---

<article class="lede">
  <div class="lede__body">
    <p class="lede__category">
      <span class="lede__desk">{deskName}</span>
      {sectionId ? <span class="lede__section">{sectionId}</span> : null}
    </p>
    <h3 class="lede__headline"><a href={href}>{post.title}</a></h3>
    {post.excerpt ? <p class="lede__deck">{post.excerpt}</p> : null}
    <p class="lede__byline">
      {author ? <>By <strong>{author}</strong> · </> : null}
      <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
      <span> · {post.readingTime} min read</span>
    </p>
    <a class="text-link lede__read" href={href}>Read the article <span aria-hidden="true">↗</span></a>
  </div>

  {post.featureImage ? (
    <figure class="lede__media-wrap">
      <a class="lede__media" href={href} aria-hidden="true" tabindex="-1">
        <img src={sitePath(post.featureImage)} alt="" loading="eager" fetchpriority="high" decoding="async" />
      </a>
    </figure>
  ) : null}
</article>
