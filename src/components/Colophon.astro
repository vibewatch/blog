---
import { config, sitePath } from '../lib/site';

const year = new Date().getUTCFullYear();
---

<footer class="colophon">
  <div class="container colophon__inner">
    <div class="colophon__identity">
      <a class="colophon__nameplate" href={sitePath('/')}>{config.title}</a>
      <p class="colophon__line">Independent writing by <strong>{config.author}</strong>.</p>
      <p class="colophon__line">Cloud architecture. Practical engineering. Open curiosity.</p>
    </div>
    <nav class="colophon__links" aria-label="Colophon">
      <a href={sitePath('/')}>Journal</a>
      <a href={sitePath('/search/')}>Search</a>
      <a href={sitePath('/tags/')}>Topics</a>
      <a href={sitePath('/desk/')}>Desks</a>
      <a href={sitePath('/series/')}>Series</a>
      <a href={sitePath('/archive/')}>Archive</a>
      <a href={sitePath('/about/')}>About</a>
      <a href={sitePath('/feed.xml')}>RSS</a>
    </nav>
    <div class="colophon__bottom"><span>© {year} {config.author}</span><span>Published on the open web.</span></div>
  </div>
</footer>
